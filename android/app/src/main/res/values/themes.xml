<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base theme; Compose drives the real colors. Edge-to-edge; window background follows
         light/dark (window_background has a values-night override) to avoid a launch flash. -->
    <style name="Theme.LGRemote" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
